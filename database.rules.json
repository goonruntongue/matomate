{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "room": {
      "config": {
        ".read": "auth != null",
        ".write": "auth != null && ((auth.token.email === 'goonruntongue@gmail.com' && auth.token.email_verified === true) || root.child('admins').child(auth.uid).val() === true)"
      },
      "state": {
        ".read": "auth != null",
        ".write": "auth != null && ((auth.token.email === 'goonruntongue@gmail.com' && auth.token.email_verified === true) || root.child('admins').child(auth.uid).val() === true)"
      },
      "seats": {
        ".read": "auth != null",
        ".write": "auth != null && ((auth.token.email === 'goonruntongue@gmail.com' && auth.token.email_verified === true) || root.child('admins').child(auth.uid).val() === true)",
        "$n": {
          ".write": "auth != null && $n.matches(/^([0-9]|[12][0-9])$/) && ((!data.exists() && newData.val() === auth.uid && !root.child('room/members').child(auth.uid).exists() && '' + newData.parent().parent().child('members').child(auth.uid).child('seat').val() === $n) || (data.val() === auth.uid && !newData.exists() && !newData.parent().parent().child('members').child(auth.uid).exists()))"
        }
      },
      "members": {
        ".read": "auth != null",
        ".write": "auth != null && ((auth.token.email === 'goonruntongue@gmail.com' && auth.token.email_verified === true) || root.child('admins').child(auth.uid).val() === true)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || newData.parent().parent().child('seats').child('' + newData.child('seat').val()).val() === auth.uid)",
          ".validate": "newData.hasChildren(['name', 'avatar', 'seat'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20 && newData.val() !== 'ゲスト'"
          },
          "avatar": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 21"
          },
          "seat": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 29 && (!data.exists() || data.val() === newData.val())"
          },
          "team": {
            ".validate": "newData.isString() && newData.val().matches(/^t[0-9]{1,2}$/) && (newData.val() === data.val() || !root.child('room/state/phase').exists() || root.child('room/state/phase').val() === 'lobby' || (auth.token.email === 'goonruntongue@gmail.com' && auth.token.email_verified === true) || root.child('admins').child(auth.uid).val() === true)"
          },
          "guest": {
            ".validate": "newData.isBoolean()"
          },
          "online": {
            ".validate": "newData.isBoolean()"
          },
          "joinedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "boards": {
        ".write": "auth != null && ((auth.token.email === 'goonruntongue@gmail.com' && auth.token.email_verified === true) || root.child('admins').child(auth.uid).val() === true)",
        "$team": {
          ".read": "auth != null && root.child('room/members').child(auth.uid).child('team').val() === $team || (auth != null && ((auth.token.email === 'goonruntongue@gmail.com' && auth.token.email_verified === true) || root.child('admins').child(auth.uid).val() === true))",
          "$round": {
            "assign": {
              "$item": {
                ".write": "auth != null && root.child('room/members').child(auth.uid).child('team').val() === $team && root.child('room/state/phase').val() === 'fixed' && !data.parent().parent().child('submitted').exists() && (!data.parent().parent().child('holds').child($item).exists() || data.parent().parent().child('holds').child($item).val() === auth.uid)",
                ".validate": "newData.hasChildren(['tray', 'at']) && newData.child('tray').isString() && newData.child('tray').val().matches(/^tray-[0-9]$/) && newData.child('at').isNumber()"
              }
            },
            "labels": {
              "$tray": {
                ".write": "auth != null && root.child('room/members').child(auth.uid).child('team').val() === $team && root.child('room/state/phase').val() === 'fixed' && !data.parent().parent().child('submitted').exists()",
                ".validate": "$tray.matches(/^tray-[0-9]$/) && newData.isString() && newData.val().length <= 20"
              }
            },
            "holds": {
              "$item": {
                ".write": "auth != null && root.child('room/members').child(auth.uid).child('team').val() === $team && root.child('room/state/phase').val() === 'fixed' && (!newData.exists() || (!data.parent().parent().child('submitted').exists() && newData.val() === auth.uid)) && (!data.exists() || data.val() === auth.uid)"
              }
            },
            "cursors": {
              "$uid": {
                ".write": "auth != null && root.child('room/members').child(auth.uid).child('team').val() === $team && $uid === auth.uid",
                ".validate": "newData.child('x').isNumber() && newData.child('y').isNumber()"
              }
            },
            "comment": {
              ".write": "auth != null && root.child('room/members').child(auth.uid).child('team').val() === $team && root.child('room/state/phase').val() === 'fixed'",
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "submitted": {
              ".write": "auth != null && root.child('room/members').child(auth.uid).child('team').val() === $team && root.child('room/state/phase').val() === 'fixed'",
              ".validate": "newData.hasChildren(['by', 'at']) && newData.child('by').val() === auth.uid && newData.child('at').isNumber()"
            }
          }
        },
        ".read": "auth != null && ((auth.token.email === 'goonruntongue@gmail.com' && auth.token.email_verified === true) || root.child('admins').child(auth.uid).val() === true)"
      },
      "chats": {
        ".write": "auth != null && ((auth.token.email === 'goonruntongue@gmail.com' && auth.token.email_verified === true) || root.child('admins').child(auth.uid).val() === true)",
        "$team": {
          ".read": "auth != null && root.child('room/members').child(auth.uid).child('team').val() === $team",
          "$msg": {
            ".write": "auth != null && root.child('room/members').child(auth.uid).child('team').val() === $team && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.child('uid').val() === auth.uid && !newData.exists()))",
            ".validate": "newData.hasChildren(['uid', 'name', 'avatar', 'text', 'at']) && newData.child('text').isString() && newData.child('text').val().length >= 1 && newData.child('text').val().length <= 500 && newData.child('name').isString() && newData.child('name').val().length <= 20 && newData.child('avatar').isNumber() && newData.child('at').isNumber()"
          }
        }
      },
      "announce": {
        ".read": "auth != null",
        ".write": "auth != null && ((auth.token.email === 'goonruntongue@gmail.com' && auth.token.email_verified === true) || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['text', 'at']) && newData.child('text').isString() && newData.child('text').val().length <= 200 && newData.child('at').isNumber()"
      }
    }
  }
}
