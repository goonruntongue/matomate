{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "room": {
      "config": {
        ".read": "auth != null",
        ".write": "auth != null && ((auth.token.email === 'goonruntongue@gmail.com' && auth.token.email_verified === true) || root.child('admins').child(auth.uid).val() === true)"
      },
      "state": {
        ".read": "auth != null",
        ".write": "auth != null && ((auth.token.email === 'goonruntongue@gmail.com' && auth.token.email_verified === true) || root.child('admins').child(auth.uid).val() === true)"
      },
      "seats": {
        ".read": "auth != null",
        ".write": "auth != null && ((auth.token.email === 'goonruntongue@gmail.com' && auth.token.email_verified === true) || root.child('admins').child(auth.uid).val() === true)",
        "$n": {
          ".write": "auth != null && $n.matches(/^([0-9]|[12][0-9])$/) && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))"
        }
      },
      "members": {
        ".read": "auth != null",
        ".write": "auth != null && ((auth.token.email === 'goonruntongue@gmail.com' && auth.token.email_verified === true) || root.child('admins').child(auth.uid).val() === true)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || newData.parent().parent().child('seats').child('' + newData.child('seat').val()).val() === auth.uid)",
          ".validate": "newData.hasChildren(['name', 'avatar', 'seat'])",
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
          "avatar": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 21" },
          "seat": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 29" },
          "team": {
            ".validate": "newData.isString() && newData.val().matches(/^t[0-9]{1,2}$/) && (newData.val() === data.val() || !root.child('room/state/phase').exists() || root.child('room/state/phase').val() === 'lobby' || (auth.token.email === 'goonruntongue@gmail.com' && auth.token.email_verified === true) || root.child('admins').child(auth.uid).val() === true)"
          },
          "guest": { ".validate": "newData.isBoolean()" },
          "online": { ".validate": "newData.isBoolean()" },
          "joinedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
