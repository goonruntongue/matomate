{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "app-dx",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev:dx"
      ],
      "port": 5174,
      "autoPort": true
    },
    {
      "name": "app-build-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "preview",
        "--",
        "--strictPort",
        "--outDir",
        "dist-pin"
      ],
      "port": 4173
    }
  ]
}
